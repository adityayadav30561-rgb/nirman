# Copy to .env.local and fill in.
# Public site URL, used for metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Blog (Sanity). Optional: the project ID iymga1c7 and dataset production
# are the defaults in src/sanity/env.ts. Set these only to use another project.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# Secret for the publish webhook (/api/revalidate/). Any long random text;
# the same text goes into the webhook's Authorization header in Sanity.
SANITY_REVALIDATE_SECRET=

# Forms (docs/sections/s1-forms.md). Secret key from resend.com; without it
# the forms open the visitor's email app instead of sending.
RESEND_API_KEY=
# Optional sender address on the domain verified in Resend.
# LEAD_FROM=website@nirmandigital.com
